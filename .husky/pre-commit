# Nexus — contrôles avant chaque commit (voir docs/agents/review-checklist.md).
set -e

# 1. Artefacts de tests et bases locales : jamais commités.
# Ajouts, copies, modifications et renommages (pour un renommage, c'est la destination).
blocked=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -E '^web/(e2e/screenshots|test-results|playwright-report)/|\.db(-wal|-shm)?$' || true)
if [ -n "$blocked" ]; then
  echo "Commit refusé : artefacts de tests ou base locale dans l'index :"
  echo "$blocked"
  echo "Retire-les avec : git restore --staged <fichier>"
  exit 1
fi

# 2. Secrets : gitleaks sur ce qui est indexé (ADR-006).
GITLEAKS=$(command -v gitleaks || true)
if [ -z "$GITLEAKS" ] && [ -n "$LOCALAPPDATA" ]; then
  lad=$(cygpath -u "$LOCALAPPDATA" 2>/dev/null || echo "$LOCALAPPDATA")
  for candidate in "$lad"/Microsoft/WinGet/Links/gitleaks.exe \
                   "$lad"/Microsoft/WinGet/Packages/Gitleaks.Gitleaks_*/gitleaks.exe; do
    if [ -x "$candidate" ]; then GITLEAKS="$candidate"; break; fi
  done
fi
if [ -z "$GITLEAKS" ]; then
  echo "Commit refusé : gitleaks introuvable. Installe-le (Windows : winget install Gitleaks.Gitleaks)."
  exit 1
fi
# La configuration lue est celle de l'index : une exception non indexée ne doit pas laisser
# passer un secret qui, lui, sera commité.
config="$(git rev-parse --git-dir)/gitleaks-staged.toml"
if ! git show :.gitleaks.toml > "$config" 2>/dev/null; then
  rm -f "$config"
  echo "Commit refusé : .gitleaks.toml doit être dans l'index."
  exit 1
fi
if ! "$GITLEAKS" git --pre-commit --staged --redact --no-banner --config "$config"; then
  rm -f "$config"
  exit 1
fi
rm -f "$config"

# 3. Lint des fichiers indexés (ruff, oxlint).
pnpm exec lint-staged

# 4. Typage et tests rapides, sur la version qui sera commitée : les modifications non
#    indexées (patch) et les fichiers non suivis (archive) sont mis de côté le temps des
#    vérifications, puis restaurés quoi qu'il arrive. La suite Playwright se lance avant
#    d'ouvrir la PR.
aside=$(mktemp -d)
git diff --binary --no-color > "$aside/unstaged.patch"
git ls-files --others --exclude-standard -z > "$aside/untracked.list"
restore() {
  ok=1
  if [ -s "$aside/untracked.tar" ]; then
    tar -xf "$aside/untracked.tar" || ok=0
  fi
  if [ -s "$aside/unstaged.patch" ]; then
    git apply --whitespace=nowarn "$aside/unstaged.patch" || ok=0
  fi
  if [ $ok = 1 ]; then
    rm -rf "$aside"
  else
    echo "Attention : travail non indexé conservé dans $aside (unstaged.patch, untracked.tar)."
  fi
}
trap restore EXIT
if [ -s "$aside/untracked.list" ]; then
  tar --null -T "$aside/untracked.list" -cf "$aside/untracked.tar"
  xargs -0 rm -f -- < "$aside/untracked.list"
fi
if [ -s "$aside/unstaged.patch" ]; then
  git checkout -- .
fi
pnpm typecheck
pnpm test
